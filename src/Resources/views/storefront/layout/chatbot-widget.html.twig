{% block chatbot_widget %}
    {% if config('ShopwareChatbotConnectorPlugin.config.active') %}
        <div class="chatbot-widget" data-chatbot-widget="true">

            <div class="chatbot-widget__panel"
                 role="dialog"
                 aria-modal="false"
                 aria-hidden="true"
                 aria-label="Chat-Assistent">
                <div class="chatbot-widget__header">
                    <div class="chatbot-widget__avatar">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M12 2a1 1 0 0 1 1 1v1.09A7.002 7.002 0 0 1 19 11v1h.5a1.5 1.5 0 0 1 0 3H19v1a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-1h-.5a1.5 1.5 0 0 1 0-3H5v-1a7.002 7.002 0 0 1 6-6.91V3a1 1 0 0 1 1-1Zm-3 9a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm6 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" fill="currentColor"/>
                        </svg>
                    </div>
                    <div class="chatbot-widget__title">
                        <strong>Chat-Assistent</strong>
                        <div class="chatbot-widget__status">Online</div>
                    </div>
                    <button type="button"
                            class="chatbot-widget__close"
                            data-chatbot-widget-close
                            aria-label="Chat schließen">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>

                <div class="chatbot-widget__messages" data-chatbot-widget-messages role="log" aria-live="polite">
                    <div class="chatbot-widget__bubble chatbot-widget__bubble--bot">
                        Hallo! Wie kann ich dir helfen?
                    </div>
                </div>

                <form class="chatbot-widget__form" data-chatbot-widget-form>
                    <input type="text"
                           class="chatbot-widget__input"
                           name="message"
                           autocomplete="off"
                           data-chatbot-widget-input
                           placeholder="Nachricht schreiben ...">
                    <button type="submit"
                            class="chatbot-widget__send"
                            data-chatbot-widget-send
                            aria-label="Senden">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M3 11l18-8-8 18-2.5-7.5L3 11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
                        </svg>
                    </button>
                </form>
            </div>

            <button type="button"
                    class="chatbot-widget__toggle"
                    data-chatbot-widget-toggle
                    aria-expanded="false"
                    aria-label="Chat öffnen">
                <svg class="icon-chat" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4.4 3.3A1 1 0 0 1 3 19.5V6a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
                <svg class="icon-close" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    {% endif %}
{% endblock %}
